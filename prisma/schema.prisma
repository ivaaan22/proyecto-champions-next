generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  EDITOR
  ADMIN
}

enum MatchStatus {
  done
  upcoming
}

enum Phase {
  FASE_DE_GRUPOS
  CUARTOS
  SEMIFINAL
  FINAL
}

model Profile {
  id        String    @id
  email     String    @unique
  username  String?
  avatarUrl String?
  role      Role      @default(USER)
  comments  Comment[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("profiles")
}

model Team {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  country     String
  crest       String
  homeMatches Match[]  @relation("HomeTeam")
  awayMatches Match[]  @relation("AwayTeam")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("teams")
}

model Match {
  id        Int         @id @default(autoincrement())
  date      String
  phase     Phase
  homeTeam  Team        @relation("HomeTeam", fields: [homeId], references: [id])
  homeId    Int
  awayTeam  Team        @relation("AwayTeam", fields: [awayId], references: [id])
  awayId    Int
  homeScore Int?
  awayScore Int?
  time      String?
  image     String?
  status    MatchStatus
  comments  Comment[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("matches")
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  match     Match    @relation(fields: [matchId], references: [id])
  matchId   Int
  author    Profile  @relation(fields: [authorId], references: [id])
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("comments")
}
